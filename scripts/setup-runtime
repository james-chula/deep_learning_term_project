#!/usr/bin/env bash
set -euo pipefail

project_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
kernel_dir="$project_root/.jupyter/share/jupyter/kernels/bloodmnist-resnet"

# MedMNIST is not packaged in the Nix environment. Install it locally, while
# retaining the Nix-provided PyTorch and analysis stack through system packages.
if ! python3.12 -c 'import medmnist' >/dev/null 2>&1; then
  uv venv --system-site-packages "$project_root/.venv"
  uv pip install --python "$project_root/.venv/bin/python" medmnist
fi

mkdir -p "$kernel_dir" \
  "$project_root/.jupyter/config" \
  "$project_root/.jupyter/data" \
  "$project_root/.jupyter/runtime"

"$project_root/.venv/bin/python" -m ipykernel install \
  --prefix "$project_root/.jupyter" \
  --name bloodmnist-resnet \
  --display-name "Python (BloodMNIST ResNet)"

cat <<EOF
Registered the repository-local kernel:
  Python (BloodMNIST ResNet)

Start the notebook server with:
  ./scripts/jupyter
EOF
